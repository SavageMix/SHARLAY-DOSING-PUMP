{
  "name": "reef-doser",
  "version": "1.0.0",
  "private": true,
  "description": "4-channel aquarium dosing pump controller",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:device": "npm run dev -w apps/device",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "npm run test -w apps/device && npm run test -w apps/mobile && npm run test -w packages/shared"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
